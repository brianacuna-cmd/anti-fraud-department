{
  "name": "anti-fraud-department",
  "version": "0.1.0",
  "private": true,
  "description": "Anti-fraud department backend — TypeScript modular monolith.",
  "main": "dist/main.js",
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "test": "jest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "bootstrap:admin": "tsx --env-file-if-exists=.env scripts/bootstrap-admin.ts",
    "migrate:unique-active-scoring-rules": "tsx --env-file-if-exists=.env scripts/migrate-unique-active-scoring-rules.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1114.0",
    "@aws-sdk/s3-request-presigner": "^3.1114.0",
    "@gorules/zen-engine": "^0.54.0",
    "bcryptjs": "^3.0.3",
    "csv-parse": "^7.0.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "jszip": "^3.10.1",
    "kafkajs": "^2.2.4",
    "mongodb": "^7.5.0",
    "multer": "^2.2.0",
    "otplib": "^12.0.1",
    "pdfkit": "^0.19.1",
    "qrcode": "^1.5.4",
    "resend": "^6.18.1",
    "talisman": "^1.1.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.2",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^10.8.0",
    "eslint-plugin-boundaries": "^7.1.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "jest": "^30.4.2",
    "mongodb-memory-server": "^11.2.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.5",
    "typescript": "^6.0.3"
  }
}
